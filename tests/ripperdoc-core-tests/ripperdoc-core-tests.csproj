<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ripperdoc-core-tests</AssemblyName>
    <RootNamespace>Ripperdoc.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Test names are the documentation here; XML doc comments on facts add
         noise without adding a reader. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ripperdoc-core\ripperdoc-core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gate script reads this same file, so which database the tier (ii)
         counts belong to has one home rather than two that can disagree. -->
    <None Include="..\measured-database.sha256" Link="measured-database.sha256">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The record of what the drift audit found, read by the checks that
         verify it is current. Only the checks read it, so there is one reader
         and nothing to disagree with. -->
    <None Include="..\drift-receipt.json" Link="drift-receipt.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
