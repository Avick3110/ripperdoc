<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>ripperdoc-core-tests</AssemblyName>
    <RootNamespace>Ripperdoc.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Test names are the documentation here; XML doc comments on facts add
         noise without adding a reader. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ripperdoc-core\ripperdoc-core.csproj" />
    <!-- The archive-lane tier reads one real directory under both naming
         postures and asserts they disagree about names and agree about
         contents, so it needs the opt-in source as well as the default one.
         A reference here says nothing about the engine core's own closure -
         that boundary is asserted by its own check. -->
    <ProjectReference Include="..\..\src\ripperdoc-naming-dictionary\ripperdoc-naming-dictionary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gate script reads this same file, so which database the tier (ii)
         counts belong to has one home rather than two that can disagree. -->
    <None Include="..\measured-database.sha256" Link="measured-database.sha256">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The record of what the drift audit found, read by the checks that
         verify it is current. Only the checks read it, so there is one reader
         and nothing to disagree with. -->
    <None Include="..\drift-receipt.json" Link="drift-receipt.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The manager-state reader's own source, read by the check that holds
         every slice by a declared length to the one primitive. Linked as text
         rather than compiled again: the check is about what the source says,
         and a file added to that directory later is picked up by the glob. -->
    <None Include="..\..\src\ripperdoc-core\ManagerState\*.cs" Link="ManagerState\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
