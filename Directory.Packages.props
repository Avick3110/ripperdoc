<Project>
  <!-- Central package management: every version in the solution is pinned in
       this one file. A version that appears in a .csproj is a defect - the
       pinned dependency is load-bearing (the engine's type model is inherited
       from WolvenKit, so a silent version drift is a silent behaviour change). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="WolvenKit.RED4" Version="8.20.0" />
    <PackageVersion Include="WolvenKit.Core" Version="8.20.0" />
    <!-- The resource-name dictionary. Referenced ONLY by the opt-in naming
         assembly, never by the engine core: it carries a mod editor's whole
         dependency tree (EF Core, SQLite, SharpDX, native texture tooling) and
         the engine is a library that a CLI and an MCP server both load. Same
         publisher, same version and same upstream commit as the two above. -->
    <PackageVersion Include="WolvenKit.Common" Version="8.20.0" />
    <!-- The tweak layer is YAML with custom tags (the !append family) and anchors.
         A stock parser is used rather than a hand-rolled subset reader: the layer
         declares types as sequence items as well as mapping keys, so a line-anchored
         parse loses a large share of them, and the mutation operators are YAML tags
         rather than syntax this project would be free to reinterpret. -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageVersion Include="xunit" Version="2.6.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>
</Project>
